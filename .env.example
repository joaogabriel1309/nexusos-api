POSTGRES_DB=nexusos
POSTGRES_USER=nexusos
POSTGRES_PASSWORD=nexusos
POSTGRES_PORT=5432

SPRING_PROFILES_ACTIVE=dev
DATABASE_URL=jdbc:postgresql://localhost:5432/nexusos
# Railway/Heroku-style DATABASE_URL also works:
# DATABASE_URL=postgresql://user:password@host:5432/database
DATABASE_JDBC_URL=jdbc:postgresql://localhost:5432/nexusos
DATABASE_USERNAME=nexusos
DATABASE_PASSWORD=nexusos
# Gere com: [Convert]::ToBase64String((1..64 | ForEach-Object { Get-Random -Maximum 256 }))
JWT_SECRET=BASE64_SECRET_COM_PELO_MENOS_256_BITS
JWT_ACCESS_EXPIRATION_MINUTES=60
JWT_REFRESH_EXPIRATION_DAYS=7
UPLOADS_PATH=uploads
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
FRONTEND_BASE_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:8080
# URL publica da API usada pelo frontend Next.js no build/runtime.
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_API_URL=https://api.mercadopago.com
# Segredo usado somente para cifrar a senha SMTP persistida (minimo de 32 caracteres).
# Se omitido, JWT_SECRET sera usado. Trocar a chave invalida a senha SMTP salva.
EMAIL_ENCRYPTION_KEY=
# Se omitido, JWT_SECRET sera usado. Trocar a chave invalida a credencial de WhatsApp salva.
WHATSAPP_ENCRYPTION_KEY=
WHATSAPP_API_URL=https://graph.facebook.com/v20.0
WHATSAPP_CALLMEBOT_API_URL=https://api.callmebot.com
WHATSAPP_DEFAULT_COUNTRY_CODE=55

# Sistema local de agentes de IA/automacao de desenvolvimento
AGENTS_TARGET_BRANCH=
# Opcional: habilita um provedor padrao para o braco programador.
# Valores suportados: codex
AGENTS_DEVELOPER_PROVIDER=
# Opcional: comando externo que implementa a tarefa antes das revisoes.
# Placeholders: {prompt}, {promptFile}, {executionFile}, {id}, {branch}, {targetBranch}, {request}, {root}
# Exemplo: AGENTS_DEVELOPER_COMMAND=codex exec --full-auto {prompt}
AGENTS_DEVELOPER_COMMAND=
AGENTS_DEVELOPER_ALLOW_RAW_COMMAND=false
AGENTS_DEVELOPER_TIMEOUT_MS=600000
# GitHub CLI usa gh auth login por padrao. Use tokens somente em ambientes nao interativos.
GH_TOKEN=
GITHUB_TOKEN=
