NODE_ENV=development
PORT=8080
DATABASE_URL=postgresql://nexusos:nexusos@localhost:5432/nexusos
# Reutilize o JWT_SECRET original para preservar credenciais criptografadas.
# Para banco novo, gere: openssl rand -base64 48
JWT_SECRET=
JWT_ACCESS_EXPIRATION_MINUTES=15
JWT_REFRESH_EXPIRATION_DAYS=7
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=Lax
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
FRONTEND_BASE_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:8080
MIGRATIONS_ENABLED=true
SWAGGER_ENABLED=true
# UPLOADS_PATH=/caminho/absoluto/para/uploads
# EMAIL_ENCRYPTION_KEY, GITHUB_ENCRYPTION_KEY, IA_ENCRYPTION_KEY,
# PAGAMENTO_ENCRYPTION_KEY e WHATSAPP_ENCRYPTION_KEY usam JWT_SECRET quando omitidas.
# Reutilize os valores originais se houver credenciais já persistidas.
